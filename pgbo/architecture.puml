@startuml
!theme plain
title Rust Application - Rocket with PostgreSQL

actor Client as C
participant "Rocket Server" as RS
participant "Database Handler" as DH
database PostgreSQL as DB

== Server Startup ==
note over RS: rocket::build()\n.mount("/", routes![index, ping,\nget_all_person_data, get_person_data_by_id])

== Endpoint /ping ==
C -> RS: GET /ping
activate RS
RS -> C: "alive"
deactivate RS

== Endpoint /test ==
C -> RS: GET /test
activate RS
RS -> DH: db_connectivity_test()
activate DH

== Database Connection ==
DH -> DB: tokio_postgres::connect("host=localhost dbname=md")
activate DB
DB -> DH: (client, connection)
deactivate DB

note over DH: Spawn connection task\ntokio::spawn(connection.await)

== Table Creation ==
DH -> DB: CREATE TABLE IF NOT EXISTS person\n(id SERIAL PRIMARY KEY,\nname TEXT NOT NULL,\ndata BYTEA)
activate DB
DB -> DH: Ok() or Error
deactivate DB

== Data Insertion ==
DH -> DB: INSERT INTO person (name, data)\nVALUES ('Ferris', NULL)
activate DB
DB -> DH: Ok() or Error
deactivate DB

== Data Query ==
DH -> DB: SELECT id, name, data FROM person
activate DB
DB -> DH: Vec<Row>
deactivate DB

loop for each row
    note over DH: println!("found person: {} {} {:?}",\nid, name, data)
end

DH -> RS: Ok() or Err(e)
deactivate DH

alt success
    RS -> C: "Database connectivity test passed"
else failure
    note over RS: eprintln!("Database connectivity test failed: {}", e)
    RS -> C: "Database connectivity test failed"
end

deactivate RS

== Endpoint /person_data ==
C -> RS: GET /person_data
activate RS
RS -> DH: read_all_person_data()
activate DH

DH -> DB: create_client()
activate DB
DB -> DH: client
deactivate DB

DH -> DB: SELECT * FROM person_data
activate DB
DB -> DH: Vec<PersonData>
deactivate DB

note over DH: PersonData {\nid, first_name, last_name,\nemail, phone, birth_date,\naddress fields, etc.}

DH -> RS: Json<Result<Vec<PersonData>, String>>
deactivate DH
RS -> C: JSON response with all person data
deactivate RS

== Endpoint /person_data/<id> ==
C -> RS: GET /person_data/123
activate RS
RS -> DH: read_person_data_by_id(123)
activate DH

DH -> DB: create_client()
activate DB
DB -> DH: client
deactivate DB

DH -> DB: SELECT * FROM person_data WHERE id = $1
activate DB
DB -> DH: Option<PersonData>
deactivate DB

DH -> RS: Json<Result<Option<PersonData>, String>>
deactivate DH
RS -> C: JSON response with specific person data
deactivate RS

== Tests ==
note over RS: #[cfg(test)]\nComprehensive test suite:\n- test_db_connectivity()\n- test_person_data_endpoints()\n- test_person_data_by_id_endpoint()\n- test_create_client_connection()

@enduml
