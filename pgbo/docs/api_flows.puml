@startuml api_flows
!theme plain
title API Flows - Complete Person Data Management

actor Client as C
participant "Rocket Server" as RS
participant "Database Module" as DM
database "PostgreSQL" as DB

== GET /ping - Health Check ==
C -> RS: GET /ping
activate RS
RS -> C: "alive"
deactivate RS

== GET /test - Database Connectivity Test ==
C -> RS: GET /test
activate RS
RS -> DM: db_connectivity_test()
activate DM
DM -> DB: create_client()
activate DB
DB -> DM: Client
deactivate DB
DM -> DB: CREATE TABLE IF NOT EXISTS person\nCREATE TABLE IF NOT EXISTS person_data
activate DB
DB -> DM: Tables created or exist
deactivate DB
DM -> DB: INSERT test data + SELECT verification
activate DB
DB -> DM: Test data results
deactivate DB
DM -> RS: Test success/failure
deactivate DM
RS -> C: "Database connectivity test passed/failed"
deactivate RS

== GET /person_data - Retrieve All Person Data ==
C -> RS: GET /person_data
activate RS
RS -> DM: read_all_person_data()
activate DM
DM -> DB: create_client()
activate DB
DB -> DM: Client
deactivate DB
DM -> DB: SELECT * FROM person_data
activate DB
DB -> DM: Vec<Row>
deactivate DB
DM -> DM: Convert rows to Vec<PersonData>
DM -> RS: Ok(Vec<PersonData>)
deactivate DM
RS -> C: JSON Response with all person data
deactivate RS

== GET /person_data/<id> - Retrieve Specific Person ==
C -> RS: GET /person_data/123
activate RS
RS -> DM: read_person_data_by_id(123)
activate DM
DM -> DB: create_client()
activate DB
DB -> DM: Client
deactivate DB
DM -> DB: SELECT * FROM person_data WHERE id = $1
activate DB
DB -> DM: Option<Row>
deactivate DB
alt Person found
    DM -> DM: Convert row to PersonData
    DM -> RS: Ok(Some(PersonData))
else Person not found
    DM -> RS: Ok(None)
end
deactivate DM
RS -> C: JSON Response with person data or null
deactivate RS

== POST /person_data - Create New Person ==
C -> RS: POST /person_data\n(JSON CreatePersonData)
activate RS
note over RS: Rocket validates JSON\nand deserializes to CreatePersonData
RS -> DM: create_person_data(person_data)
activate DM
DM -> DB: create_client()
activate DB
DB -> DM: Client
deactivate DB
DM -> DB: INSERT INTO person_data\n(first_name, last_name, email, ...)\nVALUES ($1, $2, $3, ...)\nRETURNING *
activate DB

alt Insert Success
    DB -> DM: New Row with generated ID and timestamps
    deactivate DB
    DM -> DM: Convert row to PersonData
    DM -> RS: Ok(PersonData)
    deactivate DM
    RS -> C: JSON Response with created person data
    deactivate RS
else Insert Failure (Constraint Violation)
    DB -> DM: Error (e.g., duplicate email)
    deactivate DB
    DM -> RS: Err("Failed to create person data: constraint violation")
    deactivate DM
    RS -> C: JSON Error Response
    deactivate RS
else JSON Validation Failure
    RS -> C: HTTP 422 Unprocessable Entity
    deactivate RS
end

== Error Handling ==
note over RS: All endpoints return\nJson<Result<T, String>>\nfor consistent error handling

alt Database Error
    DM -> RS: Err("Database connection failed")
    RS -> C: JSON Error Response
else SQL Error
    DM -> RS: Err("Query execution failed")
    RS -> C: JSON Error Response
else Parse Error
    DM -> RS: Err("Data parsing failed")
    RS -> C: JSON Error Response
end

== Data Structures ==
note over DM: PersonData {\n  id: i32,\n  first_name: String,\n  last_name: String,\n  email: String,\n  phone: Option<String>,\n  birth_date: Option<NaiveDate>,\n  gender: Option<String>,\n  street_address: Option<String>,\n  city: Option<String>,\n  state_province: Option<String>,\n  postal_code: Option<String>,\n  country: Option<String>,\n  nationality: Option<String>,\n  occupation: Option<String>,\n  company: Option<String>,\n  salary: Option<f64>,\n  marital_status: Option<String>,\n  created_at: Option<DateTime<Utc>>,\n  updated_at: Option<DateTime<Utc>>,\n  is_active: Option<bool>\n}

note over RS: CreatePersonData {\n  first_name: String (required),\n  last_name: String (required),\n  email: String (required),\n  phone: Option<String>,\n  birth_date: Option<NaiveDate>,\n  gender: Option<String>,\n  street_address: Option<String>,\n  city: Option<String>,\n  state_province: Option<String>,\n  postal_code: Option<String>,\n  country: Option<String>,\n  nationality: Option<String>,\n  occupation: Option<String>,\n  company: Option<String>,\n  salary: Option<f64>,\n  marital_status: Option<String>,\n  is_active: Option<bool>\n}\nNote: No id, created_at, updated_at\n(auto-generated by database)

@enduml
