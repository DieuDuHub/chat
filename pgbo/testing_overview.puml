@startuml testing_overview
!theme plain
title Testing Strategy - Rust Application

package "Unit Tests" {
    component "Database Tests" as DBTests {
        - test_create_client_connection()
        - test_create_client_strict()
        - test_db_connectivity()
    }
    
    component "API Tests" as APITests {
        - test_person_data_endpoints()
        - test_person_data_by_id_endpoint()
        - test_person_data_by_id_not_found()
    }
    
    component "HTTP Tests" as HTTPTests {
        - test_ping_endpoint()
        - test_index_endpoint()
        - test_db_connectivity_endpoint()
    }
}

package "Integration Tests" {
    component "Database Integration" as DBIntegration {
        - Real PostgreSQL connection
        - Table creation validation
        - Data insertion/retrieval
    }
    
    component "API Integration" as APIIntegration {
        - End-to-end API testing
        - JSON response validation
        - Error handling verification
    }
}

package "Test Framework" {
    [Cargo Test] as CargoTest
    [rocket::local::blocking::Client] as RocketClient
    [tokio_postgres::Client] as PostgresClient
}

package "Test Data" {
    component "pgbo_sql.toml" as TestConfig {
        - SQL queries
        - Test data
        - Table schemas
    }
}

' Relations
CargoTest --> DBTests
CargoTest --> APITests  
CargoTest --> HTTPTests
CargoTest --> DBIntegration
CargoTest --> APIIntegration

DBTests --> PostgresClient
APITests --> RocketClient
HTTPTests --> RocketClient
DBIntegration --> PostgresClient
APIIntegration --> RocketClient

DBTests --> TestConfig
APITests --> TestConfig
DBIntegration --> TestConfig

note right of DBTests : Tests database\nconnectivity and\nclient creation
note right of APITests : Tests person_data\nAPI endpoints with\nJSON responses
note right of HTTPTests : Tests basic HTTP\nendpoints for\nhealth checks

@enduml
